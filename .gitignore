# HELP.md is generated by the Spring Boot Maven plugin during the build and is not
# worth versioning; the durable documentation lives in docs/.
HELP.md

# Maven build output. Never committed: it is machine-specific and reproducible
# from the sources.
target/

# Application log output. Runtime state, not source; the durable record of what
# happened is the audit table, not a file on a developer's disk.
logs/

# With distributionType=only-script the wrapper needs no jar; this rule is the
# guard against one being added by accident.
.mvn/wrapper/maven-wrapper.jar

# Maven's reactor puts build directories under src/ for multi-module layouts.
# These two negations re-include real sources that happen to sit under a folder
# named "target".
!**/src/main/**/target/
!**/src/test/**/target/

### STS ###
# SpringSource Tool Suite / Eclipse metadata. IDE state, not source.
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### IntelliJ IDEA ###
# IntelliJ project and module files: per-developer, and they carry absolute paths.
.idea
*.iws
*.iml
*.ipr

### NetBeans ###
# NetBeans build and project metadata.
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# "build/" is a common output directory for Gradle-based tooling. The negations
# re-include any genuine source directory that happens to be called "build".
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
# Workspace settings, which are per-machine and often per-developer.
.vscode/